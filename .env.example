# Environment Mode (production or development)
NODE_ENV=production

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Database Storage Path (Make sure this directory is persistent in cloud hosting)
DATABASE_PATH=./data/coppercore.sqlite

# Proxy Configuration (1 if behind reverse proxy like Cloudflare, Render, Nginx, Railway, or Heroku)
TRUST_PROXY=1

# Secret Token for accessing GET /api/admin/enquiries
ADMIN_TOKEN=replace-with-a-long-random-secret-key-for-admin-access
